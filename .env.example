# ReedShell server configuration (copy to .env or export in your shell)

REEDSHELL_BIND=127.0.0.1:8080
REEDSHELL_ENV=development
# 32-byte Ed25519 seed, base64. Required when REEDSHELL_ENV=production.
REEDSHELL_TOKEN_KEY=

# MySQL 8.4
DATABASE_URL=mysql://reedshell:reedshell@127.0.0.1:3306/reedshell

# Redis 7
REDIS_URL=redis://127.0.0.1:6379

# Development only: allow the in-memory repository when DATABASE_URL is absent.
REEDSHELL_ALLOW_MEMORY=1
